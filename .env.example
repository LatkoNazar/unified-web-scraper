# Copy to .env; this file contains no live credentials.
OPENROUTER_API_KEY=
# Same key funds web discovery too; no separate search-provider key is required.
# Optional schema/extraction/query-planning/web-search model; default qwen/qwen3.7-flash.
OPENROUTER_MODEL=
# Optional routing model override; default openai/gpt-6-luna-decisions (native OpenRouter Luna Decisions).
OPENROUTER_DECISION_MODEL=
# Required only when selecting postgres output. Matches local Docker Compose.
DATABASE_URL=postgresql://parser:parser_dev_only@127.0.0.1:55432/parser
